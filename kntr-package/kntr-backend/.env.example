# Local development; Railway supplies service variables instead of this file.
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# DATABASE_URL takes precedence when nonempty. Never commit the real .env.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kntr
DB_USER=postgres
DB_PASSWORD=
# Private Railway networking: disable. Public TLS: require + trusted CA if needed.
DB_SSL=disable
DB_SSL_CA_FILE=

# Generate two independent values (at least 32 characters) before starting.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Include the exact origin of any separately served web interface.
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost,http://localhost:8080
# Production example: /data/uploads with a persistent volume mounted at /data.
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
QR_EXPIRY_MINUTES=60

# Never include ADMIN_BOOTSTRAP_* values in the repository or normal deployment.
# Set them privately only for the explicit npm run admin:create command.
